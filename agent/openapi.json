{
  "openapi": "3.1.0",
  "info": {
    "title": "Overcover agent service",
    "version": "1.0.0",
    "description": "The local agent service that holds an autonomous agent's NEAR key and can call exactly one contract method, buy_cover, under a spending policy. It is not hosted publicly: it binds 127.0.0.1 by default and is dry-run by default. A policy refusal happens before any network call, so a denied purchase moves no funds. This document is generated by hand from agent/server.mjs; tests/agent-openapi.test.mjs asserts it matches the running routes.",
    "license": { "name": "MIT" }
  },
  "servers": [{ "url": "http://127.0.0.1:8787", "description": "local service (default bind)" }],
  "tags": [{ "name": "agent", "description": "discover, decide and buy under the spending policy" }],
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and identity, without any secret",
        "responses": {
          "200": {
            "description": "service is up",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Health" } } }
          }
        }
      }
    },
    "/api/v1/agent": {
      "get": {
        "operationId": "status",
        "summary": "Status, limits, spend history and the live account balance",
        "responses": {
          "200": {
            "description": "current status",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } }
          }
        }
      }
    },
    "/api/v1/agent/audit": {
      "get": {
        "operationId": "audit",
        "summary": "The last 50 append-only audit entries",
        "responses": {
          "200": {
            "description": "audit tail",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Audit" } } }
          }
        }
      }
    },
    "/api/v1/agent/quote": {
      "post": {
        "operationId": "quote",
        "summary": "The contract's own premium for a product and payout",
        "requestBody": { "$ref": "#/components/requestBodies/Quote" },
        "responses": {
          "200": {
            "description": "the premium the contract would charge",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Quote" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/agent/decide": {
      "post": {
        "operationId": "decide",
        "summary": "Allow/deny for a proposed purchase (no purchase is made)",
        "requestBody": { "$ref": "#/components/requestBodies/Decide" },
        "responses": {
          "200": {
            "description": "the policy verdict",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Verdict" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/api/v1/agent/buy": {
      "post": {
        "operationId": "buy",
        "summary": "Buy cover if, and only if, the policy allows it",
        "description": "Refuses with 403 before any network call when the policy denies the purchase or the account cannot cover the premium plus a gas buffer. In dry-run it evaluates and audits but sends nothing. A replayed idempotency key returns the original result and does not buy again.",
        "parameters": [
          { "name": "Idempotency-Key", "in": "header", "required": false, "schema": { "type": "string", "maxLength": 200 } }
        ],
        "requestBody": { "$ref": "#/components/requestBodies/Buy" },
        "responses": {
          "200": {
            "description": "purchase result (real hash, or a dry-run echo)",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BuyResult" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "403": { "$ref": "#/components/responses/Denied" },
          "413": { "$ref": "#/components/responses/TooLarge" },
          "502": { "$ref": "#/components/responses/ChainError" }
        }
      }
    },
    "/api/v1/agent/control": {
      "post": {
        "operationId": "control",
        "summary": "The runtime kill switch",
        "requestBody": { "$ref": "#/components/requestBodies/Control" },
        "responses": {
          "200": {
            "description": "the new enabled state",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Control" } } }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "Quote": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/QuoteRequest" } } }
      },
      "Decide": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DecideRequest" } } }
      },
      "Buy": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/BuyRequest" } } }
      },
      "Control": {
        "required": true,
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ControlRequest" } } }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "malformed request",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "Denied": {
        "description": "the spending policy refused the purchase, before any network call",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Denied" } } }
      },
      "TooLarge": {
        "description": "the request body exceeded the size limit",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      },
      "ChainError": {
        "description": "the chain rejected or failed the transaction",
        "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
      }
    },
    "schemas": {
      "Yocto": { "type": "string", "pattern": "^[0-9]+$", "description": "an exact non-negative integer in yoctoNEAR (1 NEAR = 10^24 yoctoNEAR). Never parse as a float." },
      "Health": {
        "type": "object",
        "required": ["ok", "service", "accountId", "contractId", "dryRun", "enabled"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "service": { "type": "string", "const": "overcover-agent" },
          "accountId": { "type": "string" },
          "contractId": { "type": "string" },
          "dryRun": { "type": "boolean" },
          "enabled": { "type": "boolean" }
        }
      },
      "Status": {
        "type": "object",
        "properties": {
          "accountId": { "type": "string" },
          "contractId": { "type": "string" },
          "enabled": { "type": "boolean" },
          "dryRun": { "type": "boolean" },
          "limits": { "type": "object" },
          "history": { "type": "array", "items": { "type": "object" } },
          "balanceYocto": { "type": ["string", "null"], "pattern": "^[0-9]+$" }
        }
      },
      "Audit": {
        "type": "object",
        "required": ["entries"],
        "properties": { "entries": { "type": "array", "items": { "type": "object" } } }
      },
      "QuoteRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "payoutYocto"],
        "properties": { "productId": { "type": "string" }, "payoutYocto": { "$ref": "#/components/schemas/Yocto" } }
      },
      "Quote": {
        "type": "object",
        "required": ["productId", "payoutYocto", "premiumYocto"],
        "properties": {
          "productId": { "type": "string" },
          "payoutYocto": { "$ref": "#/components/schemas/Yocto" },
          "premiumYocto": { "$ref": "#/components/schemas/Yocto" }
        }
      },
      "DecideRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "payoutYocto", "obsDateSec"],
        "properties": {
          "productId": { "type": "string" },
          "payoutYocto": { "$ref": "#/components/schemas/Yocto" },
          "obsDateSec": { "type": "integer", "minimum": 0, "description": "unix seconds; must be in the future" }
        }
      },
      "Verdict": {
        "type": "object",
        "required": ["allow", "reasons", "premiumYocto"],
        "properties": {
          "allow": { "type": "boolean" },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "premiumYocto": { "$ref": "#/components/schemas/Yocto" }
        }
      },
      "BuyRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["productId", "payoutYocto", "obsDateSec"],
        "properties": {
          "productId": { "type": "string" },
          "payoutYocto": { "$ref": "#/components/schemas/Yocto" },
          "obsDateSec": { "type": "integer", "minimum": 0 },
          "beneficiary": { "type": ["string", "null"] },
          "idempotencyKey": { "type": "string", "maxLength": 200 }
        }
      },
      "BuyResult": {
        "type": "object",
        "required": ["premiumYocto"],
        "properties": {
          "hash": { "type": ["string", "null"] },
          "premiumYocto": { "$ref": "#/components/schemas/Yocto" },
          "explorer": { "type": ["string", "null"] },
          "dryRun": { "type": "boolean" },
          "idempotentReplay": { "type": "boolean" }
        }
      },
      "ControlRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["enabled"],
        "properties": { "enabled": { "type": "boolean" } }
      },
      "Control": {
        "type": "object",
        "required": ["enabled"],
        "properties": { "enabled": { "type": "boolean" } }
      },
      "Error": {
        "type": "object",
        "required": ["error", "message"],
        "properties": { "error": { "type": "string" }, "message": { "type": "string" } }
      },
      "Denied": {
        "type": "object",
        "required": ["error", "message", "reasons"],
        "properties": {
          "error": { "type": "string", "const": "denied" },
          "message": { "type": "string" },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
