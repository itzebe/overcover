{
  "name": "overcover",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "node agent/server.mjs",
    "axe": "node tests/axe.mjs",
    "build:wallet": "node scripts/build-wallet.mjs",
    "demo": "node driver/demo.js",
    "deploy": "OVERCOVER_DEMO_WINDOW=60 node driver/deploy.js",
    "fixture:capture": "node scripts/capture-fixture.mjs",
    "keys": "node driver/keys.js",
    "operator": "node driver/operator.js",
    "products:feed": "node scripts/products-feed.mjs",
    "simulate:full": "node sim/run.mjs",
    "simulate:lifecycle": "node sim/run.mjs",
    "test": "npm run test:model && npm run test:sim && npm run test:contract && npm run test:console && npm run test:agent && npm run test:deploy",
    "test:agent": "node --test tests/agent-limits.test.mjs tests/agent-api.test.mjs tests/json-bigint.test.mjs tests/agent-funds.test.mjs tests/agent-openapi.test.mjs",
    "test:agent-eval": "node --test tests/products-feed.test.mjs tests/agent-eval.test.mjs tests/agent-integration.test.mjs",
    "test:console": "node --test tests/console.test.js tests/wallet-journey.test.mjs",
    "test:factory": "node --test tests/factory-discovery.test.mjs",
    "factory:feed": "node scripts/factory-feed.mjs",
    "test:contract": "cargo +stable test --manifest-path contract/Cargo.toml",
    "test:deploy": "node --test tests/upgrade-guard-refusal.test.mjs tests/controlled-v3-funding.test.mjs tests/factory-deploy-harness.test.mjs",
    "test:model": "node research/model/attacks.mjs",
    "test:onchain": "node --test tests/*.test.js",
    "test:sim": "node --test tests/model.test.mjs tests/v3-message.test.mjs",
    "ui:qa": "node tests/ui.browser.mjs",
    "upgrade": "node driver/upgrade.js",
    "redeploy:v3": "node driver/redeploy-v3.mjs",
    "verify:agent": "node proof/agent-policy.mjs",
    "verify:connectivity": "node proof/connectivity.mjs",
    "verify:live": "node proof/live-check.mjs",
    "verify:migration": "node proof/migration-auth.mjs",
    "verify:sec1-takeover": "node proof/sec1-takeover.mjs",
    "verify:release-ops": "node proof/release-ops.mjs",
    "verify:preservation": "node scripts/verify-preservation.mjs",
    "verify:preservation:snapshot": "node scripts/verify-preservation.mjs --snapshot",
    "verify:upgrade": "node proof/upgrade-guard.mjs",
    "verify:upgrade-preservation": "node proof/upgrade-state-preservation.mjs",
    "verify:proof": "node proof/verify.mjs",
    "verify:sandbox": "node tests/sandbox-lifecycle.mjs",
    "verify:testnet-deploy": "node proof/testnet-v2-deploy.mjs",
    "verify:controlled-v3": "node proof/controlled-v3-deploy.mjs",
    "verify:controlled-v3:plan": "node proof/controlled-v3-deploy.mjs --plan",
    "verify:controlled-v3:sandbox": "node proof/controlled-v3-deploy.mjs --sandbox",
    "verify:controlled-v3:evidence": "node proof/controlled-v3-evidence.mjs",
    "verify:factory": "node proof/factory-sandbox.mjs",
    "ui:viewports": "node tests/viewport-audit.mjs",
    "poc:outlayer:build": "cargo build --manifest-path poc/outlayer-attested-observation/adapter/Cargo.toml --target wasm32-wasip2 --release",
    "poc:outlayer:demo": "node poc/outlayer-attested-observation/bin/integration-demo.mjs",
    "poc:outlayer:test": "node --test \"poc/outlayer-attested-observation/test/*.test.mjs\"",
    "poc:outlayer:verify": "node poc/outlayer-attested-observation/bin/verify-attestation.mjs",
    "poc:outlayer:execute": "node poc/outlayer-attested-observation/bin/execute-on-outlayer.mjs"
  },
  "dependencies": {
    "@near-wallet-selector/core": "^10.1.4",
    "@near-wallet-selector/here-wallet": "^10.1.4",
    "@near-wallet-selector/meteor-wallet": "^10.1.4",
    "near-api-js": "^5.1.1"
  },
  "devDependencies": {
    "axe-core": "^4.14.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.1",
    "esbuild": "^0.28.2",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "playwright-core": "^1.65.0",
    "process": "^0.11.10",
    "stream-browserify": "^3.0.0",
    "util": "^0.12.5",
    "vm-browserify": "^1.1.2"
  },
  "overrides": {
    "nanoid": "^5.1.16",
    "@here-wallet/core": {
      "bn.js": "^5.2.3"
    },
    "borsh": {
      "bn.js": "^5.2.3"
    },
    "bs58": {
      "base-x": "^3.0.11"
    },
    "query-string": {
      "decode-uri-component": "0.5.1"
    }
  }
}
